"dinner_with_Mikazuki": "res://Assets/Dialogic Files/dinner_with_Mikazuki.dtl",
"elevator": "res://Assets/Dialogic Files/elevator.dtl",
"manmer_afterquest": "res://Assets/Dialogic Files/manmer_afterquest.dtl",
"manmer_notfoundyet": "res://Assets/Dialogic Files/manmer_notfoundyet.dtl",
