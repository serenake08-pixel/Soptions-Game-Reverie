"sheep": "res://Assets/Dialogic Files/sheep.dtl",
"shelf": "res://Assets/Dialogic Files/shelf.dtl",
"stopsign": "res://Assets/Dialogic Files/stopsign.dtl"
}
layout/style_directory={
"": "res://Assets/Dialogic Files/dialogboxtest.tres",
"dialogboxtest": "res://Assets/Dialogic Files/dialogboxtest.tres"
}
layout/style_list=["res://Assets/Dialogic Files/dialogboxtest.tres"]
layout/default_style="res://Assets/Dialogic Files/dialogboxtest.tres"
variables={
"Inventory": {
"RESUME": false
},
"NewVar": "",
"collectable": "nothing?",
"finishedFish": false,
"i": 0,
"metFish": false,
"metMikazuki": true,
"reverse": false,
"rng": -1
}
glossary/default_case_sensitive=true

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

