; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Soptions Game"
run/main_scene="uid://dnwn7ftadcbh"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
run/layer_3="Interactables"
run/layer_2="Player"
run/layer_1="World"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
Global="*uid://cw1a6xv2kis2f"

[dialogic]

directories/dch_directory={
"Manmer": "res://Assets/Dialogic Files/Manmer.dch",
"Mikazuki": "res://Assets/Dialogic Files/Mikazuki.dch",
"Sheep": "res://Assets/Dialogic Files/Sheep.dch",
"you": "res://Assets/Dialogic Files/you.dch"
}
directories/dtl_directory={
